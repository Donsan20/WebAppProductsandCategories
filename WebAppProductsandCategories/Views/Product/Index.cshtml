@model IEnumerable<WebAppProductsandCategories.Models.Product>

<h1>Productos</h1>

<a href="@Url.Action("Create")" class="btn btn-primary">Crear Nuevo Producto</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>ID Producto</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Categoría</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.Name</td>
                <td>@product.Price.ToString("C")</td>
                <td>@GetCategoryName(product.CategoryId)</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = product.ProductId })" class="btn btn-warning btn-sm">Editar</a>
                    <a href="@Url.Action("Delete", new { id = product.ProductId })" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@functions {
    // Función auxiliar en Razor para buscar el nombre de la categoría usando el CategoryId
    private string GetCategoryName(int categoryId)
    {
        var category = ViewBag.Categories as List<WebAppProductsandCategories.Models.Category>;
        return category?.FirstOrDefault(c => c.CategoryId == categoryId)?.Name ?? "Sin Categoría";
    }
}