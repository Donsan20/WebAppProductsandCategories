@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-5">
    <h1 class="display-4">Bienvenido al Catálogo</h1>
    <p class="lead">Gestión de Productos y Categorías con ASP.NET Core MVC y ADO.NET</p>

    <div class="mt-4">
        <a asp-controller="Category" asp-action="Index" class="btn btn-outline-primary btn-lg mx-2">
            Gestionar Categorías
        </a>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-success btn-lg mx-2">
            Gestionar Productos
        </a>
    </div>
</div>